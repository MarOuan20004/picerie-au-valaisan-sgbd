# Auto-detect text files and normalize line endings
* text=auto

# Source files with LF line endings
*.java text eol=lf diff=java
*.sql text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf
Makefile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.jar binary
*.class binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
