# ==============================================================================
# .gitignore - Projet Au Valaisan (Java / JDBC / Oracle)
# ==============================================================================

# Fichiers de compilation Java
*.class
bin/
out/
target/
*.jar
!libs/ojdbc17.jar
*.war
*.ear

# Configuration et secrets de connexion base de donnees
config.properties
db.properties
.env
*.local
*.secret

# Fichiers d'environnement et logs
*.log
*.log.*
logs/
hs_err_pid*
replay_pid*

# IDEs et Editeurs
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.settings/
.project
.classpath
.factorypath
*.sublime-project
*.sublime-workspace

# OS et systemes de fichiers
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*~
*.swp
*.swo

# Fichiers temporaires
tmp/
temp/
scratch/
